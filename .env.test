# Test Environment Configuration
# This file defines environment variables specific to the test environment

KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
APP_ENV=test
APP_DEBUG=true

# Database Configuration for Testing
# Using encrypted secrets for secure credential management
# Create test database secrets with: bin/console secrets:set DATABASE_URL --env=test
# DATABASE_URL will be loaded from config/secrets/test/

# Redis Configuration for Testing  
# Using encrypted secrets for secure credential management
# Create test Redis secrets with: bin/console secrets:set REDIS_URL --env=test
# REDIS_URL will be loaded from config/secrets/test/

# JWT Configuration for Testing
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=5b10a8d6daf767d3020c7af2a66e13c3487b01e19736dffc403e1de11753d204

# Router Configuration
DEFAULT_URI=http://moneymoveapi.com

# Logging Configuration
LOG_LEVEL=debug

# Disable external services during testing
EXTERNAL_API_ENABLED=false
